# ============================================================================
# malefly-ai — ninja build (requires ninja-build >= 1.11, g++ >= 11)
#   ninja              : build binaries + tests
#   ninja run_tests    : build and run unit tests
#   ninja run_goal1    : run Goal 1 experiment (results -> results/)
# ============================================================================

cxx      = g++
cxxflags = -std=c++17 -O2 -Wall -Wextra -Wpedantic -Isrc
ldflags  =

rule cxx
  command  = $cxx $cxxflags -MMD -MF $out.d -c $in -o $out
  depfile  = $out.d
  deps     = gcc
  description = CXX $in

rule link
  command  = $cxx $in -o $out $ldflags
  description = LINK $out

rule run
  command  = ./$in && echo "PASSED $in"
  description = RUN $in

rule run_exp
  command  = ./$in
  description = EXP $in

# ---- objects ----
build build/obj/core/lif.o:               cxx src/core/lif.cpp
build build/obj/core/synapses.o:          cxx src/core/synapses.cpp
build build/obj/util/odors.o:             cxx src/util/odors.cpp
build build/obj/circuits/antennal_lobe.o: cxx src/circuits/antennal_lobe.cpp
build build/obj/circuits/mushroom_body.o: cxx src/circuits/mushroom_body.cpp
build build/obj/env/environment.o:        cxx src/env/environment.cpp
build build/obj/experiments/goal1.o:      cxx src/experiments/goal1.cpp
build build/obj/experiments/goal2.o:      cxx src/experiments/goal2.cpp
build build/obj/experiments/calib.o:      cxx src/experiments/calib.cpp
build build/obj/main.o:                   cxx src/main.cpp
build build/obj/tests/test_core.o:        cxx src/tests/test_core.cpp

# ---- binaries ----
build build/malefly: link build/obj/main.o build/obj/experiments/goal1.o build/obj/experiments/goal2.o build/obj/experiments/calib.o build/obj/core/lif.o build/obj/core/synapses.o build/obj/util/odors.o build/obj/circuits/antennal_lobe.o build/obj/circuits/mushroom_body.o build/obj/env/environment.o
build build/test_core: link build/obj/tests/test_core.o build/obj/core/lif.o build/obj/core/synapses.o build/obj/util/odors.o build/obj/circuits/antennal_lobe.o build/obj/circuits/mushroom_body.o build/obj/env/environment.o

# ---- actions ----
build run_tests: run build/test_core
build run_goal1: run_exp build/malefly

build all: phony build/malefly build/test_core
default all
